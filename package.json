{
  "name": "relaxify",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/server.js",
    "build": "pip install -U yt-dlp",
    "dev": "nodemon server/server.js",
    "electron:dev": "cd client && npx vite build --mode electron && cd .. && npx electron .",
    "desktop:build": "cd client && npx vite build --mode electron && cd .. && npx electron-builder --win"
  },
  "build": {
    "appId": "com.relaxify.app",
    "productName": "Relaxify",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.js",
      "server/**/*",
      "!server/node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "client/dist",
        "to": "client-dist"
      },
      {
        "from": "electron/bin/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      },
      {
        "from": "server/.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "client/public/logo.png"
    }
  },
  "type": "commonjs",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
